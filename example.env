# Copy this file to  local.env  and fill in the values.
#
#   local.env is git-ignored and has never been committed. Verified across the repository's
#   full history. Do not rename it, do not move it out of the project root, and do not paste
#   its contents into a chat, an issue or a screenshot.
#
# A trading key without withdrawal rights cannot move money off the exchange even if it
# leaks; that single checkbox is the cheapest protection available here. It applies to
# BOTH key pairs below.

# The TESTNET pair MUST be created on the demo/testnet site, withdrawals DISABLED.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ── REAL EXCHANGE — REAL MONEY ─────────────────────────────────────────────────
# The bot runs against the demo venue unless ALL of the following hold. Filling in
# only the keys does nothing; setting only the flag refuses to start. The real key
# MUST be created on binance.com with WITHDRAWALS DISABLED and an IP whitelist.
# REAL_MODE=observe (the default) reads the account and accepts closes but never
# opens; switch to trade only after an observe run looked right.
# The launcher tools\start-real.ps1 sets REAL_TRADING and REAL_MODE itself —
# keep both commented here so a demo run can never inherit them by accident.
BINANCE_REAL_API_KEY=
BINANCE_REAL_API_SECRET=
# REAL_TRADING=ARMED
# REAL_MODE=observe

# Optional — only for `--source supabase`.
SUPABASE_URL=
SUPABASE_QUEUE_KEY=

# Optional — alerts. Without these, alerts still go to the log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — one Telegram line per trade (23.09): every entry fill and every exit (take,
# stop, 48h, trend exit, /close, close-all, a close in the Binance app, liquidation), in
# Russian, with an estimated P&L marked "≈" (fees and funding are not in it; /pnl has the
# exchange's net). on by default; off silences only these lines, never an alert.
# TRADE_NOTIFY=on
# Warsaw wall-clock window in which trade lines are HELD and sent as one 🌙 summary when it
# ends ("23-08" or "23:30-07:15"; unset = no quiet hours). Warnings and critical alerts are
# never held. The held lines live in memory: a restart inside the window loses them (the
# journal and /pnl still have every trade).
# QUIET_HOURS=23-08

# Optional — default leverage when a signal does not specify one. Hard cap is 5.
DEFAULT_LEVERAGE=2

# ── Protections (28.08) — defaults are ON; the variables exist to opt OUT ──────
# What a tripped daily loss limit DOES. flatten (default): close the whole book
# reduce-only so -3% means -3%. halt-only: the pre-28.08 behaviour - block new
# entries and let the open losers run to their exchange stops.
# KILL_SWITCH_ACTION=flatten

# An entry signal older than this many minutes is refused - a backlog written
# during a stall must not execute at market on another market's prices. Closes
# are never stale. 0 disables the gate.
# SIGNAL_MAX_AGE_MIN=90

# Risk per trade as a fraction of balance. Default 0.005 (0.5%); the hard cap in code is
# 0.01 (1%) and cannot be raised by any variable. Doubling it doubles BOTH the expected
# return and the drawdown, halves how many stop-outs the -3% daily limit tolerates (3
# instead of 6), and at ~$137 equity admits about twice as many coins past the $5 minimum.
# Read by the bot AND the scanner (its feasibility check), so keep it in one place.
# RISK_PER_TRADE=0.005

# Sizing: when the lot-floored quantity falls under the exchange's $5 minimum, round the
# lot UP to that minimum as long as the risk stays within the tolerance above the 0.5%
# budget and under the 1% hard cap. Coins that size normally are never touched: only the
# floor-constrained ones carry the extra risk. on = 0.20 (risk up to 0.6%). A fraction sets
# the tolerance: 0.50 = risk up to 0.75%, 1.00 = up to the 1% cap. Measured 05.09 at ~$137
# on the 32 candidates the scanner called "too wide": 6 clear at 0.20, 20 at 0.50, 31 at
# 1.00 (one lot step, the rule before 05.09, cleared 3). Read by the bot AND the scanner.
# LOT_ROUND_UP=on

# Entry execution. Default market. ENTRY_TYPE=limit rests the entry at the signal price for
# ENTRY_FILL_WINDOW_SEC (default 60, clamped 5..600; measured 05.09: 16 of 17 fill inside a
# minute) and cancels the remainder; a cancel that fails keeps the entry on record so a late
# fill is adopted with its stop by the reconciler. NOT to be switched on without the owner:
# the fill rate is a shadow measurement, not a live one.
# ENTRY_TYPE=market
# ENTRY_TIF=GTC
# ENTRY_FILL_WINDOW_SEC=60

# Scanner: skip a candidate whose 60d correlation with an open position exceeds
# this (measured 26.08: worst day -5.4% -> -2.5%, drawdown 11% -> 7%, cost ~8pp
# of return). Unset = off, shadow-logged only. Decision date: 14.09.
# MAX_CORR=0.75

# Scanner: on a day BTC closed red, draw NEW entries from the coins that do NOT follow it
# (the least-correlated fifth of a deeper cap list) instead of the top-100. Exits, stops,
# takes, leverage and the 48h cap are unchanged - same rules, different pool.
# Measured 29.08 on 2019-26 (analysis/regimeuni/h5.py): on the clean window the switch earns
# +67.0%/y against the unswitched base's -0.5%/y, t 1.42 against the lab's t>=2.0 bar. BELOW
# THE BAR - armed by the owner as a deliberate risk, not because it is proven.
# Off (unset) = the scanner behaves exactly as before, and costs no extra requests.
# BEAR_UNIVERSE=on
# BEAR_DAY_PCT=0.0        # how red the day must be; 0.0 = any red day (the measured primary)
