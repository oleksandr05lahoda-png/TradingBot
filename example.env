# Copy this file to  local.env  and fill in the values.
#
#   local.env is git-ignored and has never been committed. Verified across the repository's
#   full history. Do not rename it, do not move it out of the project root, and do not paste
#   its contents into a chat, an issue or a screenshot.
#
# The key MUST be created on the demo/testnet site, and it MUST have withdrawals DISABLED.
# A trading key without withdrawal rights cannot move money off the exchange even if it leaks;
# that single checkbox is the cheapest protection available here.

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ── REAL EXCHANGE — REAL MONEY ─────────────────────────────────────────────────
# The bot runs against the demo venue unless ALL of the following hold. Filling in
# only the keys does nothing; setting only the flag refuses to start. The real key
# MUST be created on binance.com with WITHDRAWALS DISABLED and an IP whitelist.
# REAL_MODE=observe (the default) reads the account and accepts closes but never
# opens; switch to trade only after an observe run looked right.
# The launcher tools\start-real.ps1 sets REAL_TRADING and REAL_MODE itself —
# keep both commented here so a demo run can never inherit them by accident.
BINANCE_REAL_API_KEY=
BINANCE_REAL_API_SECRET=
# REAL_TRADING=ARMED
# REAL_MODE=observe

# Optional — only for `--source supabase`.
SUPABASE_URL=https://ptlxojilgqylzxshsrlm.supabase.co
SUPABASE_QUEUE_KEY=

# Optional — alerts. Without these, alerts still go to the log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — default leverage when a signal does not specify one. Hard cap is 5.
DEFAULT_LEVERAGE=3
