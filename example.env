# Copy this file to  local.env  and fill in the values.
#
#   local.env is git-ignored and has never been committed. Verified across the repository's
#   full history. Do not rename it, do not move it out of the project root, and do not paste
#   its contents into a chat, an issue or a screenshot.
#
# A trading key without withdrawal rights cannot move money off the exchange even if it
# leaks; that single checkbox is the cheapest protection available here. It applies to
# BOTH key pairs below.

# The TESTNET pair MUST be created on the demo/testnet site, withdrawals DISABLED.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ── REAL EXCHANGE — REAL MONEY ─────────────────────────────────────────────────
# The bot runs against the demo venue unless ALL of the following hold. Filling in
# only the keys does nothing; setting only the flag refuses to start. The real key
# MUST be created on binance.com with WITHDRAWALS DISABLED and an IP whitelist.
# REAL_MODE=observe (the default) reads the account and accepts closes but never
# opens; switch to trade only after an observe run looked right.
# The launcher tools\start-real.ps1 sets REAL_TRADING and REAL_MODE itself —
# keep both commented here so a demo run can never inherit them by accident.
BINANCE_REAL_API_KEY=
BINANCE_REAL_API_SECRET=
# REAL_TRADING=ARMED
# REAL_MODE=observe

# Optional — only for `--source supabase`.
SUPABASE_URL=
SUPABASE_QUEUE_KEY=

# Optional — alerts. Without these, alerts still go to the log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — default leverage when a signal does not specify one. Hard cap is 5.
DEFAULT_LEVERAGE=2

# ── Protections (28.08) — defaults are ON; the variables exist to opt OUT ──────
# What a tripped daily loss limit DOES. flatten (default): close the whole book
# reduce-only so -3% means -3%. halt-only: the pre-28.08 behaviour - block new
# entries and let the open losers run to their exchange stops.
# KILL_SWITCH_ACTION=flatten

# An entry signal older than this many minutes is refused - a backlog written
# during a stall must not execute at market on another market's prices. Closes
# are never stale. 0 disables the gate.
# SIGNAL_MAX_AGE_MIN=90

# Scanner: skip a candidate whose 60d correlation with an open position exceeds
# this (measured 26.08: worst day -5.4% -> -2.5%, drawdown 11% -> 7%, cost ~8pp
# of return). Unset = off, shadow-logged only. Decision date: 14.09.
# MAX_CORR=0.75
